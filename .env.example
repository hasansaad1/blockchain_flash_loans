# ============================================
# SEPOLIA TESTNET CONFIGURATION
# ============================================

# RPC Endpoint for Sepolia Testnet
# Get a free RPC URL from: https://www.alchemy.com/, https://infura.io/, or https://www.quicknode.com/
RPC_URL_SEPOLIA=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# Alternative: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Wallet Private Key (without 0x prefix)
# ⚠️ WARNING: Never commit this file to git! This is your private key.
# Get testnet ETH from: https://sepoliafaucet.com/ or https://faucet.quicknode.com/ethereum/sepolia
WALLET_PRIVATE_KEY=your_private_key_here_without_0x_prefix

# ============================================
# AAVE V3 SEPOLIA ADDRESSES
# ============================================

# Aave V3 Pool Addresses Provider on Sepolia
# Official address: https://docs.aave.com/developers/deployed-contracts/v3-testnet-addresses
AAVE_POOL_ADDRESSES_PROVIDER_SEPOLIA=0x012bAC54348C0E052dCaD1655D96F3B11c0Cb0AA

# ============================================
# TOKEN ADDRESSES ON SEPOLIA
# ============================================

# Wrapped ETH (WETH) on Sepolia
# This is the token we'll borrow in the flash loan
WETH_TOKEN_SEPOLIA=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14

# DAI Token on Sepolia (for arbitrage)
# This is the intermediate token we'll swap through
DAI_TOKEN_SEPOLIA=0x3e622317f8C93f7328350cF0B56d9eD4C620C5d6

# ============================================
# DEX ROUTER ADDRESSES ON SEPOLIA
# ============================================

# Uniswap V2 Router on Sepolia
# Used as the source DEX for buying tokens
UNISWAP_ROUTER_SEPOLIA=0xC532a74256D3Db42D0Bf7a0400fEFDbad7694008

# Sushiswap Router on Sepolia
# Used as the destination DEX for selling tokens
# Note: Sushiswap may not be available on Sepolia. You may need to use a different DEX or deploy test routers.
# Alternative: Use Uniswap V2 Router for both (testing purposes)
SUSHISWAP_ROUTER_SEPOLIA=0xC532a74256D3Db42D0Bf7a0400fEFDbad7694008
